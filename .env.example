# Server-only runtime settings. Never put real values in source control.
# One selected inference provider powers saved checks and public Wolfgang chat.
GUARDIAN_PROVIDER=baseten
GUARDIAN_API_KEY=
GUARDIAN_MODEL=
# Optional endpoint/format overrides. Defaults supplied for Baseten/Fireworks/Meta.
GUARDIAN_API_URL=
GUARDIAN_API_FORMAT=chat-completions
# Required for a custom HTTPS provider such as your Modal endpoint.
GUARDIAN_ALLOWED_API_ORIGINS=
# JSON mode is omitted automatically for Baseten Muse Spark Open and Modal/custom.
# Set off or json_object only after checking the selected model's capabilities.
GUARDIAN_JSON_MODE=
# Server-side per-call bounds; these do not replace a provider account spend cap.
GUARDIAN_MAX_INPUT_BYTES=300000
GUARDIAN_MAX_OUTPUT_TOKENS=1800
# Shared durable ceilings for public chat and server speech, separate from checks.
WOLFGANG_PUBLIC_DAILY_LIMIT=500
WOLFGANG_VISITOR_DAILY_LIMIT=24

# Legacy fallback: leave the whole Guardian provider/key/model/URL/format group blank.
WOLFGANG_API_KEY=
WOLFGANG_MODEL=
WOLFGANG_API_URL=
WOLFGANG_API_FORMAT=chat-completions
# Optional dedicated spoken voice. Device speech works without these.
WOLFGANG_TTS_API_KEY=
WOLFGANG_TTS_URL=
WOLFGANG_TTS_ALLOWED_API_ORIGINS=
WOLFGANG_TTS_MODEL=
WOLFGANG_TTS_VOICE=

# Gmail/Outlook delegated account connections. Keep disabled until approved.
CONNECTION_ENCRYPTION_KEY=
GMAIL_CONNECT_ENABLED=false
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=https://guardian.peopleorganised.com/api/connections/gmail/callback
OUTLOOK_CONNECT_ENABLED=false
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_REDIRECT_URI=https://guardian.peopleorganised.com/api/connections/outlook/callback

# Shared routing secret. Native adapters sign normalised events internally.
CONTACT_GATEWAY_SECRET=
CONTACT_CHANNELS=
# Native receiving and reply adapters. These do not provision provider accounts.
MESSAGING_PUBLIC_ORIGIN=https://guardian.peopleorganised.com/
MESSAGING_SUPPORT_EMAIL=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Receive authenticated WhatsApp messages without AI or automatic replies.
WHATSAPP_RECEIVING_ENABLED=false
MESSENGER_PAGE_ID=
MESSENGER_PAGE_ACCESS_TOKEN=
# Receive authenticated Page messages without AI or automatic replies.
MESSENGER_RECEIVING_ENABLED=false
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
RESEND_INBOX_ID=
WOLFGANG_EMAIL_FROM=
WOLFGANG_EMAIL_RECEIVING_ADDRESS=
# Set only when using a separately verified external gateway.
CONTACT_EXTERNAL_GATEWAY_ENABLED=false
WOLFGANG_EMAIL=
WOLFGANG_EMAIL_ENABLED=false
WOLFGANG_WHATSAPP_NUMBER=
WOLFGANG_WHATSAPP_ENABLED=false
WOLFGANG_SMS_NUMBER=
WOLFGANG_SMS_ENABLED=false
WOLFGANG_MESSENGER_URL=
WOLFGANG_MESSENGER_ENABLED=false
WOLFGANG_INSTAGRAM_URL=
WOLFGANG_INSTAGRAM_ENABLED=false
WOLFGANG_X_URL=
WOLFGANG_X_ENABLED=false

# Own-account X OAuth and legacy DM transport. This does not support XChat.
# Client credentials and app-only bearer are different credential families.
X_CONNECT_ENABLED=false
X_CLIENT_ID=
X_CLIENT_SECRET=
X_APP_BEARER_TOKEN=
X_REDIRECT_URI=https://guardian.peopleorganised.com/api/messaging/x/callback
X_OPERATOR_ORIGIN=https://admin.peopleorganised.com/
X_OPERATOR_RETURN_URL=https://admin.peopleorganised.com/operator/guardian
WOLFGANG_X_HANDLE=WolfgangOnCall
# Explicit intake-only testing may queue/ack without inference or replies.
X_RECEIVING_ENABLED=false
# Set only after X confirms the automated AI reply use case is approved.
X_AUTOMATED_REPLIES_APPROVED=false

# Shared canonical accounts live in the private People Organised service.
PEOPLE_ORGANISED_AUTH_ORIGIN=https://admin.peopleorganised.com
GUARDIAN_IDENTITY_SECRET=
# Separate server-only bridge for operator records and own-account X setup.
GUARDIAN_ADMIN_TOKEN=

# Pre-AI supervised email reception; keeps automatic customer replies disabled.
EMAIL_RECEIVING_ENABLED=false
# Fixed operator test replies require an explicitly selected canonical test owner.
# Never configure this by guessing an owner from an email address.
GUARDIAN_TRANSPORT_TEST_ENABLED=false
GUARDIAN_TRANSPORT_TEST_OWNER_ID=

# Reviewed IMAP/POP3 service. Credentials stay in its encrypted vault, not here.
MAILBOX_CONNECT_ENABLED=false
# Nominate one canonical Guardian owner for acceptance without public activation.
MAILBOX_TEST_OWNER_ID=
MAILBOX_CONNECTOR_ORIGIN=
MAILBOX_SIGNING_KEY=
# JSON [{"id":"owned-imap","protocol":"imap","label":"Your mail provider","domains":["example.com"],"mxDomains":["mailhost.example.com"]}]
# Optional discovery domains select an existing reviewed profile, never a host.
# IDs must match reviewed host entries on the separately hosted connector.
MAILBOX_REVIEWED_PROVIDERS=[]

# Permit signed-in Guardian customers to link X independently of AI replies.
X_PUBLIC_LINKING_ENABLED=false

# Optional signed-in link reputation. Choose google-web-risk,
# virustotal-community for Google baseline + eligible Community reports,
# or virustotal-commercial
# with a suitable licence. See docs/LINK_REPUTATION.md.
# Community mode needs both the Google and Community secrets below.
# These credentials must be secrets on the server, never browser variables.
GUARDIAN_LINK_REPUTATION=
GUARDIAN_GOOGLE_WEB_RISK_API_KEY=
GUARDIAN_VIRUSTOTAL_COMMUNITY_KEY=
GUARDIAN_VIRUSTOTAL_COMMERCIAL_KEY=

# Paid, customer-opted-in inbox previews. Keep off until owned-mail acceptance and
# a working scheduled trigger; these switches alone never grant access.
GUARDIAN_WATCH_ENABLED=false
GUARDIAN_WATCH_GMAIL=false
GUARDIAN_WATCH_OUTLOOK=false
GUARDIAN_WATCH_ORIGIN=
# Optional watch-only external cron relay (never reuse another service key).
GUARDIAN_WATCH_TRIGGER_ENABLED=false
GUARDIAN_WATCH_TRIGGER_KEY=

# Optional evaluation access gate and owner-scoped inspection log.
GUARDIAN_JURY_MODE=false
GUARDIAN_JURY_CODE=
GUARDIAN_INSPECTOR_ENABLED=false
